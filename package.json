{
  "name": "vinexpenses",
  "private": true,
  "description": "VinExpenses: React web app (src/) and its Supabase backend (supabase/).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"tests/*.test.js\"",
    "test:web": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "check:web": "npm run lint && npm run typecheck && npm run test:web && npm run build",
    "fixture": "node tools/make-fixture.js",
    "emails": "node tools/auth-emails.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.8",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-query": "5.108.4",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-router-dom": "7.18.6",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1"
  }
}
