# Copy this file to ".env" and fill in your own values:
#   cp .env.example .env
# Then run:  node build-config.js

# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase -> Project Settings -> API -> "anon" / public key
# (NOT the service_role key — config.js is delivered to the browser)
SUPABASE_ANON_KEY=your-anon-public-key

# ---- React app (web/ build: npm run dev / npm run build) ----
# The same two public values, with the VITE_ prefix. Never put a secret here: everything with VITE_ is sent to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: the PUBLIC site key of the Cloudflare Turnstile security check
VITE_TURNSTILE_SITE_KEY=
# Optional: the public address of the site (for example https://yourname.pages.dev), used for the sitemap and social-preview links.
VITE_SITE_URL=

# Optional: a Google Analytics (GA4) measurement ID. It is loaded on the public pages only, and only after the visitor says yes. Public value.
VITE_GA_ID=
